
@page "/notifications"
@rendermode InteractiveServer

@using SmartHome.Models
@using Microsoft.JSInterop
@inject NavigationManager Navigation

@using System.Net.Http.Json

@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<div class="page">

    <header class="page-header">

        <div>
            <p class="eyebrow">MY HOME</p>
            <h1>Уведомления</h1>
            <p class="subtitle">
                События вашего умного дома
            </p>
        </div>

        <div class="page-title-icon">
            🔔
        </div>

    </header>

    <div class="push-notification-settings">
        <button class="push-button" @onclick="EnableNotifications">
            🔔 Включить уведомления
        </button>
    </div>

    <button class="push-button" @onclick="TestPush">
        🧪 Тестовое уведомление
    </button>

    <p>@pushResult</p>



    <div class="notifications-list">

        @if (notification.Count == 0)
        {
            <div class="empty-notifications">

                <div class="empty-icon">
                    🔔
                </div>

                <h3>Уведомлений пока нет</h3>

                <p>
                    Здесь будут появляться события вашего дома
                </p>

            </div>
        }
        else
        {
            @foreach (var notification in notification)
            {
                <div class="notification-card">

                    <div class="notification-icon">
                        @notification.Icon
                    </div>

                    <div class="notification-content">

                        <h3>
                            @notification.Title
                        </h3>

                        <p>
                            @notification.Description
                        </p>

                        <span class="notification-time">
                            @notification.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </span>

                    </div>

                </div>
            }
        }

    </div>

</div>


@code {
    private HomeData? homeData;
    private bool loading = true;
    private bool error = false;
    private List<Notification> notification = new();

    private void Notification()
    {
        if (homeData != null)
        {
            if (homeData.GasDetected == true)
            {
                notification.Add(new Notification
                {
                    Title = "ОБНАРУЖЕН ГААААЗ!!!!",
                    Description = "Датчик газа обнаружил опасный уровень газа",
                    Icon = "🔥",
                    CreatedAt = DateTime.UtcNow
                });

            }


            if (homeData.SecurityEnabled == true && homeData.MotionDetected == true)
            {
                notification.Add(new Notification { Title = "ДВИЖЕИНИИЕЕЕЕ!!!!", Description = "ДАТЧИК ДВИДЕНИЕ УВИДЕЛ ДВИДЕНИЕ", Icon = "💃🏿", CreatedAt = DateTime.UtcNow });
            }
        }

    }


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("HomeApi");

            homeData = await client.GetFromJsonAsync<HomeData>("api/home");

            Notification();

            error = homeData == null;
        }
        catch
        {
            error = true;

        }
        finally
        {
            loading = false;
        }
    }

    private async Task EnableNotifications()
    {
        try
        {
            var publicKey = "BFX-X1h-RYlIYA4Kn2cKggnVpMfEfjJdDH1GqLfpPNGgcC1w5yOuReZXgn0Ziot9a9ZT1m_frxQ6QBfEnHgMb-I";

            var subscription = await JS.InvokeAsync<PushSubscriptionData>(
                "pushNotifications.subscribe",
                publicKey
            );

            var client = HttpClientFactory.CreateClient("HomeApi");

            var response = await client.PostAsJsonAsync(
                "api/home/push-subscription",
                subscription
            );

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Push-подписка сохранена!");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка push-уведомлений: {ex.Message}");
        }
    }

    // private async Task TestPush()
    // {
    //     try
    //     {
    //         var client = HttpClientFactory.CreateClient("HomeApi");

    //         var response = await client.PostAsync(
    //             "api/home/test-push",
    //             null
    //         );

    //         Console.WriteLine(await response.Content.ReadAsStringAsync());
    //     }
    //     catch (Exception ex)
    //     {
    //         Console.WriteLine($"Ошибка тестового push: {ex.Message}");
    //     }
    // }
    private string pushResult = "";

    private async Task TestPush()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("HomeApi");

            var response = await client.PostAsync(
                "api/home/test-push",
                null
            );

            var text = await response.Content.ReadAsStringAsync();

            pushResult = $"HTTP {(int)response.StatusCode}: {text}";
        }
        catch (Exception ex)
        {
            pushResult = $"ОШИБКА: {ex.Message}";
        }
    }

    public class PushSubscriptionData
    {
        public string Endpoint { get; set; } = "";
        public string P256dh { get; set; } = "";
        public string Auth { get; set; } = "";
    }
   
    public class HomeData
    {
        public bool GasDetected { get; set; }
        public bool SecurityEnabled { get; set; }
        public bool MotionDetected { get; set; }
    }
}

