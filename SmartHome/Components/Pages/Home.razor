@* @page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization


@rendermode InteractiveServer

@inject IJSRuntime JS
@inject NavigationManager Navigation
@using System.Net.Http.Json

@inject IHttpClientFactory HttpClientFactory

<div id="three-home-world" class="three-world"></div>

<div class="page">

    <header class="page-header">

        <div>
            <p class="eyebrow">MY HOME</p>

            <h1>Добро пожаловать 👋</h1>

            <p class="subtitle">
                Вот состояние вашего дома сейчас
            </p>
        </div>

        <button class="notification-button" @onclick="OpenNotifications">
            🔔
            <span></span>
        </button>

    </header>


    <section class="welcome-card">

        <div class="welcome-content">

            <p class="eyebrow">СТАТУС ДОМА</p>

            @if (loading)
            {
                <h2>Загрузка...</h2>

                <p>
                    Получаем данные от станции.
                </p>
            }
            else if (error)
            {
                <h2>Станция недоступна</h2>

                <p>
                    Не удалось получить данные от API.
                </p>
            }
            else
            {
                <h2>
                    @if (homeData!.GasDetected)
                    {
                        <span>Обнаружен газ ⚠️</span>
                    }
                    else if (homeData!.MotionDetected)
                    {
                        <span>Обнаружено движение 👀</span>
                    }
                    else
                    {
                        <span>Всё работает нормально</span>
                    }
                </h2>

                <p>
                    Станция подключена и все системы работают.
                </p>
            }

        </div>

        <div class="welcome-icon">
            🏠
        </div>

    </section>


    <section class="stats-grid">

        <!-- ТЕМПЕРАТУРА -->

        <div class="stat-card">

            <div class="stat-icon">
                🌡️
            </div>

            <div>

                <p>Температура</p>

                @if (loading)
                {
                    <h2>...</h2>
                }
                else if (error)
                {
                    <h2>—</h2>
                }
                else
                {
                    <h2>
                        @homeData!.IndoorTemperature.ToString("0.0")°C
                    </h2>
                }

            </div>

        </div>


        <!-- ВЛАЖНОСТЬ -->

        <div class="stat-card">

            <div class="stat-icon">
                💧
            </div>

            <div>

                <p>Влажность</p>

                @if (loading)
                {
                    <h2>...</h2>
                }
                else if (error)
                {
                    <h2>—</h2>
                }
                else
                {
                    <h2>
                        @homeData!.Humidity.ToString("0")%
                    </h2>
                }

            </div>

        </div>


        <!-- СТАНЦИЯ -->

        <div class="stat-card">

            <div class="stat-icon">
                📡
            </div>

            <div>

                <p>Станция</p>

                @if (loading)
                {
                    <h2>Проверка...</h2>
                }
                else if (error)
                {
                    <h2 class="offline-text">
                        Офлайн
                    </h2>
                }
                else
                {
                    <h2 class="online-text">
                        Онлайн
                    </h2>
                }

            </div>

        </div>

    </section>


    <!-- ДОПОЛНИТЕЛЬНАЯ ИНФОРМАЦИЯ -->
    @if (!loading && !error)
    {
        <section class="stats-grid">
            <!-- УЛИЦА -->

            <div class="stat-card">

                <div class="stat-icon">
                    🌤️
                </div>

                <div>

                    <p>На улице</p>

                    <h2>
                        @homeData!.OutdoorTemperature.ToString("0.0")°C
                    </h2>

                </div>

            </div>


            <!-- ГАЗ -->

            <div class="stat-card">

                <div class="stat-icon">
                    🔥
                </div>

                <div>

                    <p>Газ</p>

                    <h2>
                        @homeData!.GasValue
                    </h2>

                </div>

            </div>


            <!-- ДВИЖЕНИЕ -->

            <div class="stat-card">

                <div class="stat-icon">
                    👀
                </div>

                <div>

                    <p>Движение</p>

                    @if (homeData!.MotionDetected)
                    {
                        <h2>
                            Обнаружено
                        </h2>
                    }
                    else
                    {
                        <h2>
                            Нет
                        </h2>
                    }

                </div>

            </div>

        </section>


        <!-- ОХРАНА -->

        <section class="welcome-card">

            <div class="welcome-content">

                <p class="eyebrow">
                    БЕЗОПАСНОСТЬ
                </p>

                <h2>

                    @if (homeData!.SecurityEnabled)
                    {
                        <span>Охрана включена 🔒</span>
                    }
                    else
                    {
                        <span>Охрана выключена 🔓</span>
                    }

                </h2>

                <p>
                    Состояние системы безопасности дома.
                </p>

            </div>

            <div class="welcome-icon">
                @(homeData!.SecurityEnabled ? "🔒" : "🔓")
            </div>

        </section>
    }

</div>



@code {
    private HomeData? homeData;
    private bool loading = true;
    private bool error = false;



    private System.Threading.Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadHomeData();

        timer = new System.Threading.Timer(
            async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadHomeData();
                    StateHasChanged();
                });
            },
            null,
            TimeSpan.FromSeconds(5),
            TimeSpan.FromSeconds(5)
        );
    }



    private async Task LoadHomeData()
    {
