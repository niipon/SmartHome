@page "/remote"
@using System.Diagnostics;
@using SmartHome.Services
@rendermode InteractiveServer
@inject TvRemoteService TvRemote
@inject AdbService Adb

<div class="remote-page">

    <div class="remote-wrapper">

        <div class="remote">

            <!-- POWER -->
            <button class="power-button" @onclick="Power">
                <span class="power-symbol">⏻</span>
            </button>

            <!-- GOOGLE ASSISTANT -->
            <button class="assistant-button" @onclick="Assistant">
                <span class="google-dot blue"></span>
                <span class="google-dot red"></span>
                <span class="google-dot yellow"></span>
                <span class="google-dot green"></span>
            </button>

            <!-- NAVIGATION -->
            <div class="navigation">

                <button class="nav-up" @onclick="Up">
                    <span>⌃</span>
                </button>

                <button class="nav-left" @onclick="Left">
                    <span>‹</span>
                </button>

                <button class="nav-ok" @onclick="Ok">
                    <span>OK</span>
                </button>

                <button class="nav-right" @onclick="Right">
                    <span>›</span>
                </button>

                <button class="nav-down" @onclick="Down">
                    <span>⌄</span>
                </button>

            </div>

            <!-- THREE BUTTONS -->
            <div class="three-buttons">

                <!-- APPS -->
                <button class="small-button apps-button"
                        @onclick="Apps"
                        aria-label="Приложения">

                    <span class="apps-grid">
                        <i></i><i></i><i></i>
                        <i></i><i></i><i></i>
                        <i></i><i></i><i></i>
                    </span>

                </button>

                <!-- BACK -->
                <button class="small-button back-button"
                        @onclick="Back"
                        aria-label="Назад">

                    <span class="back-icon">‹</span>

                </button>

                <!-- HOME -->
                <button class="small-button home-button"
                        @onclick="Home"
                        aria-label="Главный экран">

                    <span class="home-icon">○</span>

                </button>

            </div>

            <!-- NETFLIX / PRIME -->
            <div class="service-buttons">

                <button class="service netflix"
                        @onclick="Netflix">
                    NETFLIX
                </button>

                <button class="service prime"
                        @onclick="Prime">

                    <span class="prime-small">prime</span>
                    <span class="video-small">video</span>

                </button>

            </div>

            <!-- VOLUME -->
            <div class="volume-control">

                <button class="volume-button volume-up"
                        @onclick="VolumeUp"
                        aria-label="Увеличить громкость">

                    <span>+</span>

                </button>

                <div class="volume-divider"></div>

                <button class="volume-button volume-down"
                        @onclick="VolumeDown"
                        aria-label="Уменьшить громкость">

                    <span>−</span>

                </button>

            </div>

        </div>

    </div>

</div>


@code {
