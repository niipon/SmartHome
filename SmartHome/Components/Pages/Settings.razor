
@page "/settings"
@rendermode InteractiveServer
@inject IJSRuntime JS

<div class="settings-page">

    <div class="settings-top">
        <div>
            <div class="settings-eyebrow">MY HOME</div>
            <h1>Settings</h1>
            <p>Система управления домом</p>
        </div>

        <div class="settings-status">
            <span></span>
            SYSTEM ONLINE
        </div>
    </div>

    <div class="dna-wrapper">
        <div id="settingsDna"></div>

        <div class="dna-hint">
            DRAG TO ROTATE
        </div>
    </div>

</div>

@code
{
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await JS.InvokeVoidAsync("myHomeSettingsDna.init");
        }
        catch (Exception ex)
        {
            Console.WriteLine("MY HOME SETTINGS DNA ERROR: " + ex.Message);
        }
    }
}

