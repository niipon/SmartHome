@page "/settings"

@rendermode InteractiveServer

@using Microsoft.JSInterop

@inject IJSRuntime JS

<div class="page">

    <!-- HEADER -->

    <div class="page-header">

        <div>

            <p class="eyebrow">
                MY HOME
            </p>

            <h1>
                Settings
            </h1>

            <p class="subtitle">
                Управление системой умного дома
            </p>

        </div>

        <div class="page-title-icon">
            ⚙
        </div>

    </div>


    <!-- 3D SKIN -->

    <div class="settings-section">

        <p class="eyebrow">
            APPEARANCE
        </p>

        <div class="settings-group">

            <div class="setting-item">

                <div class="setting-link">

                    <div class="setting-icon blue">
                        ◈
                    </div>

                    <div class="setting-content">

                        <h3>
                            3D Skin
                        </h3>

                        <p>
                            Выберите стиль интерфейса MY HOME
                        </p>

                    </div>

                </div>


                <div class="theme-buttons">

                    <button @onclick='() => SelectTheme("Cyber")'>
                        🌑
                        <span>Cyber</span>
                    </button>

                    <button @onclick='() => SelectTheme("Minimal")'>
                        🧊
                        <span>Minimal</span>
                    </button>

                    <button @onclick='() => SelectTheme("Matrix")'>
                        🟢
                        <span>Matrix</span>
                    </button>

                    <button @onclick='() => SelectTheme("Space")'>
                        🌌
                        <span>Space</span>
                    </button>

                    <button @onclick='() => SelectTheme("Classic")'>
                        🏠
                        <span>Classic</span>
                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- MANAGEMENT -->

    <div class="settings-section">

        <p class="eyebrow">
            MANAGEMENT
        </p>

        <div class="settings-group">


            <!-- USERS -->

            <div class="setting-item">

                <a href="/users" class="setting-link">

                    <div class="setting-icon blue">
                        👥
                    </div>

                    <div class="setting-content">

                        <h3>
                            Users
                        </h3>

                        <p>
                            Управление пользователями дома
                        </p>

                    </div>

                    <span class="arrow">
                        ›
                    </span>

                </a>

            </div>


            <!-- SECURITY -->

            <div class="setting-item">

                <a href="/security" class="setting-link">

                    <div class="setting-icon red">
                        🛡
                    </div>

                    <div class="setting-content">

                        <h3>
                            Security
                        </h3>

                        <p>
                            Настройки безопасности дома
                        </p>

                    </div>

                    <span class="arrow">
                        ›
                    </span>

                </a>

            </div>


        </div>

    </div>


    <!-- SYSTEM -->

    <div class="settings-section">

        <p class="eyebrow">
            SYSTEM
        </p>

        <div class="settings-group">


            <!-- HOME -->

            <div class="setting-item">

                <a href="/" class="setting-link">

                    <div class="setting-icon blue">
                        🏠
                    </div>

                    <div class="setting-content">

                        <h3>
                            Home
                        </h3>

                        <p>
                            Основной дом
                        </p>

                    </div>

                    <span class="arrow">
                        ›
                    </span>

                </a>

            </div>


        </div>

    </div>


    <!-- ABOUT -->

    <div class="settings-section">

        <p class="eyebrow">
            ABOUT
        </p>

        <div class="settings-group">

            <div class="setting-item">

                <div class="setting-link">

                    <div class="setting-icon">
                        ℹ
                    </div>

                    <div class="setting-content">

                        <h3>
                            MY HOME
                        </h3>

                        <p>
                            Smart Home System
                        </p>

                    </div>

                    <span class="setting-value">
                        v1.0.0
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- FOOTER -->

    <div class="settings-footer">

        <strong>
            MY HOME
        </strong>

        <span>
            Smart Home System • Version 1.0.0
        </span>

    </div>

</div>


@code {

    private async Task SelectTheme(string theme)
    {
        await JS.InvokeVoidAsync(
            "MyHomeTheme.apply",
            theme
        );
    }

}