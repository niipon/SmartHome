<style>

    * {
        box-sizing: border-box;
    }

    .home-plan-page {
        min-height: 100vh;
        width: 100%;
        padding: 35px;
        background: radial-gradient(circle at top left, #ffffff 0%, #f1f3f4 45%, #e9ecef 100%);
        font-family: Inter, Arial, sans-serif;
    }


    .plan-wrapper {
        max-width: 1450px;
        margin: 0 auto;
        background: rgba(255,255,255,.88);
        border-radius: 28px;
        box-shadow: 0 25px 70px rgba(25,35,45,.14);
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.8);
    }


    /* HEADER */

    .plan-header {
        height: 90px;
        padding: 0 35px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #e5e8ea;
        background: rgba(255,255,255,.92);
    }


    .plan-title {
        font-size: 27px;
        font-weight: 800;
        letter-spacing: 3px;
        color: #202832;
    }


    .plan-subtitle {
        margin-top: 4px;
        color: #899198;
        font-size: 14px;
    }


    .plan-status {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 10px 16px;
        border-radius: 30px;
        background: #f1f5f1;
        color: #526456;
        font-size: 13px;
        font-weight: 600;
    }


    .status-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #6d9568;
        box-shadow: 0 0 0 5px rgba(109,149,104,.12);
    }


    /* CONTENT */

    .plan-content {
        display: grid;
        grid-template-columns: minmax(700px, 1fr) 330px;
        gap: 25px;
        padding: 30px;
    }


    .floor-plan {
        min-width: 0;
        background: #ffffff;
        border-radius: 22px;
        padding: 15px;
        box-shadow: inset 0 0 0 1px #edf0f1;
    }


        .floor-plan svg {
            display: block;
            width: 100%;
            height: auto;
        }


    /* TEXT */

    .room-title {
        font-size: 16px;
        font-weight: 700;
        fill: #252d35;
        letter-spacing: .3px;
    }


    .room-size {
        font-size: 13px;
        font-weight: 500;
        fill: #626c73;
    }


    .compass {
        font-size: 13px;
        font-weight: 700;
        fill: #34414b;
    }


    /* RIGHT PANEL */

    .info-panel {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }


    .info-card {
        padding: 22px;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid #e7eaec;
        box-shadow: 0 8px 25px rgba(30,40,50,.06);
    }


        .info-card h3 {
            margin: 0 0 18px;
            font-size: 18px;
            color: #27323b;
        }


    .room-row,
    .dimension {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 10px 0;
        border-bottom: 1px solid #eef0f1;
        font-size: 13px;
        color: #667079;
    }


        .room-row:last-child,
        .dimension:last-child {
            border-bottom: none;
        }


        .room-row strong {
            color: #34424c;
            font-weight: 700;
        }


        .dimension b {
            color: #34424c;
            font-weight: 600;
            white-space: nowrap;
        }


    .smart-card {
        background: linear-gradient( 145deg, #f7faf7, #eef4ee );
    }


    .smart-title {
        font-size: 16px;
        font-weight: 800;
        letter-spacing: 1.5px;
        color: #344c38;
        margin-bottom: 15px;
    }


    .smart-item {
        font-size: 13px;
        color: #59675c;
        margin-top: 10px;
    }


        .smart-item span {
            color: #6f956b;
            margin-right: 7px;
        }


    /* АДАПТАЦИЯ */

    @@media (max-width: 1050px) {
        .plan-content

    {
        grid-template-columns: 1fr;
    }

    .info-panel {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
    }

    }


    @@media (max-width: 700px) {
        .home-plan-page

    {
        padding: 10px;
    }

    .plan-header {
        padding: 0 20px;
    }

    .plan-content {
        padding: 12px;
    }

    .info-panel {
        grid-template-columns: 1fr;
    }

    .plan-status {
        display: none;
    }

    }
</style>