</div>


<style>

    /* =========================
       ОСНОВА
    ========================= */

    .home-plan-page {
        width: 100%;
        min-height: 100vh;

        background: #eef0f2;

        display: flex;
        justify-content: center;
        align-items: flex-start;

        padding: 35px;

        box-sizing: border-box;

        overflow: auto;
    }


    .plan-card {
        width: 1000px;

        background: #ffffff;

        border-radius: 24px;

        padding: 25px;

        box-shadow:
            0 20px 60px rgba(20, 30, 40, 0.15);

        box-sizing: border-box;
    }


    .house-plan {
        display: block;

        width: 100%;

        height: auto;
    }


    /* =========================
       ПОЛ
    ========================= */

    .floor {
        stroke: none;
    }

    .room-floor {
        fill: #f5f1e8;
    }

    .hallway-floor {
        fill: #eee9df;
    }

    .balcony-floor {
        fill: #dfe5e8;
    }

    .bathroom-floor {
        fill: #e8eef1;
    }


    /* =========================
       СТЕНЫ
    ========================= */

    .wall {
        fill: none;

        stroke: #202832;

        stroke-width: 9;

        stroke-linejoin: miter;
    }


    /* =========================
       ОКНА
    ========================= */

    .window {
        fill: #d9edf7;

        stroke: #79aabd;

        stroke-width: 2;
    }

    .window-line {
        stroke: #79aabd;

        stroke-width: 1.5;
    }


    /* =========================
       ДВЕРИ
    ========================= */

    .door {
        stroke: #303943;

        stroke-width: 3;

        fill: none;
    }

    .door-arc {
        stroke: #8b949e;

        stroke-width: 1.5;

        fill: none;

        stroke-dasharray: 4 3;
    }

    .door-opening {
        fill: #ffffff;

        stroke: none;
    }


    /* =========================
       МЕБЕЛЬ
    ========================= */

    .bed {
        fill: #c9bda9;

        stroke: #a99b86;

        stroke-width: 1.5;
    }

    .pillow {
        fill: #f8f6f1;

        stroke: #ddd8cf;

        stroke-width: 1;
    }

    .wood-furniture {
        fill: #aa8c68;

        stroke: #8c7254;

        stroke-width: 1;
    }

    .carpet {
        fill: #ded8cc;

        stroke: #c8c0b2;

        stroke-width: 1;
    }

    .mirror {
        fill: #d9e8ed;

        stroke: #91aab3;

        stroke-width: 2;
    }

    .pouf {
        fill: #9d9385;
    }

    .chair {
        fill: #9b9285;

        stroke: #81786d;

        stroke-width: 1;
    }

    .balcony-table {
        fill: #a88b6b;

        stroke: #856d53;

        stroke-width: 1;
    }


    /* =========================
       ВАННАЯ
    ========================== */

    .bath {
        fill: #ffffff;

        stroke: #9baab2;

        stroke-width: 2;
    }

    .sink {
        fill: #ffffff;

        stroke: #9baab2;

        stroke-width: 2;
    }

    .toilet {
        fill: #ffffff;

        stroke: #9baab2;

        stroke-width: 2;
    }


    /* =========================
       НАЗВАНИЯ
    ========================== */

    .room-name {
        fill: #27313b;

        font-family: Arial, sans-serif;

        font-size: 13px;

        font-weight: 600;

        text-anchor: middle;

        letter-spacing: 0.3px;
    }

</style>