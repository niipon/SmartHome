@page "/security"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using Microsoft.JSInterop

@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

@implements IDisposable

<div class="security-page">

    <!-- Верхняя часть -->
    <div class="security-top">

        <div>
            <div class="security-eyebrow">
                MY HOME
            </div>

            <h1>Security</h1>

            <p>Система безопасности дома</p>
        </div>

        <div class="security-online">
            <span></span>
            SYSTEM ONLINE
        </div>

    </div>


    <!-- 3D -->
    <div class="security-3d-wrapper">

        <div id="security3d"></div>

        <div class="security-drag-hint">
            DRAG TO ROTATE
        </div>

    </div>


    <!-- Центральная информация -->
    <div class="security-control">

        <div class="security-state">

            <div class="security-state-label">
                STATUS
            </div>

            <div class="security-state-value @(securityEnabled ? "active" : "inactive")">

                @(securityEnabled
                                ? "ОХРАНА АКТИВНА"
                                : "ОХРАНА ВЫКЛЮЧЕНА")

            </div>

        </div>


        <button class="security-button"
                @onclick="ToggleSecurity">

            @(securityEnabled
                        ? "ВЫКЛЮЧИТЬ ОХРАНУ"
                        : "ВКЛЮЧИТЬ ОХРАНУ")

        </button>


        <div class="security-motion">

            <div class="security-motion-label">
                MOTION SENSOR
            </div>

            <div class="security-motion-value @(homeData.MotionDetected ? "motion" : "")">

                @(homeData.MotionDetected
                                ? "ДВИЖЕНИЕ ОБНАРУЖЕНО"
                                : "ДВИЖЕНИЯ НЕТ")

            </div>

        </div>

    </div>

</div>


@code {

    private HomeData homeData = new HomeData();

    private bool securityEnabled;

    private System.Threading.Timer? timer;

    private bool security3dInitialized;


    private async Task ToggleSecurity()
    {
        securityEnabled = !securityEnabled;

        var client =
            HttpClientFactory.CreateClient("HomeApi");

        await client.PostAsJsonAsync(
            "api/home/security",
            securityEnabled
        );

        await LoadHomeData();

        StateHasChanged();
    }


    protected override async Task OnInitializedAsync()
    {
        await LoadHomeData();

        timer = new System.Threading.Timer(
            async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadHomeData();

                    StateHasChanged();
                });
            },
            null,
            TimeSpan.FromSeconds(5),
            TimeSpan.FromSeconds(5)
        );
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "myHomeSecurity3d.init"
                );

                security3dInitialized = true;
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    "MY HOME SECURITY 3D ERROR: " + ex.Message
                );
            }
        }

        if (security3dInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "myHomeSecurity3d.setState",
                    securityEnabled,
                    homeData.MotionDetected
                );
            }
            catch
            {
                // JS может быть недоступен во время перехода страницы
            }
        }
    }


    private async Task LoadHomeData()
    {
        try
        {
            var client =
                HttpClientFactory.CreateClient("HomeApi");

            homeData =
                await client.GetFromJsonAsync<HomeData>(
                    "api/home"
                ) ?? new HomeData();

            securityEnabled =
                homeData.SecurityEnabled;
        }
        catch
        {
            // API временно недоступен
        }
    }


    public void Dispose()
    {
        timer?.Dispose();
    }


    public class HomeData
    {
        public bool SecurityEnabled { get; set; }

        public bool MotionDetected { get; set; }
    }

}