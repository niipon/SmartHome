@page "/lights"
@rendermode InteractiveServer

@inject IJSRuntime JS

<div class="lights-page">

    <!-- HEADER -->
    <div class="lights-header">

        <div>
            <div class="lights-eyebrow">MY HOME</div>

            <h1>Освещение</h1>

            <p>
                Управление светом в комнатах
            </p>
        </div>

        <div class="lights-status">
            <span></span>
            SYSTEM ONLINE
        </div>

    </div>


    <!-- 3D ЛАМПОЧКА -->
    <div class="lamp-wrapper">

        <div id="lights3d"></div>

        <div class="lamp-hint">
            DRAG TO ROTATE
        </div>

    </div>


    <!-- ПАНЕЛЬ УПРАВЛЕНИЯ -->
    <div class="lights-control">

        <div class="lights-control-top">

            <div>
                <span class="control-label">
                    ОСВЕЩЕНИЕ
                </span>

                <div class="control-title">
                    Комнаты
                </div>
            </div>

            <div class="lights-counter">
                <strong>
                    @lights.Count(x => x.Enabled)
                </strong>

                <span>
                    / @lights.Count
                </span>
            </div>

        </div>


        <div class="lights-buttons">

            @foreach (var light in lights)
            {
                <button class="light-button @(light.Enabled ? "active" : "")"
                        @onclick="() => ToggleLight(light)">

                    <div class="light-button-icon">
                        @light.Icon
                    </div>

                    <div class="light-button-info">

                        <span class="light-button-name">
                            @light.Name
                        </span>

                        <span class="light-button-state">
                            @(light.Enabled ? "Включён" : "Выключен")
                        </span>

                    </div>

                    <div class="light-dot"></div>

                </button>
            }

        </div>

    </div>

</div>


@code
{
    private List<LightItem> lights = new()
    {
        new LightItem
        {
            Name = "Комната",
            Icon = "◉",
            Enabled = true
        },

        new LightItem
        {
            Name = "Кухня",
            Icon = "◇",
            Enabled = false
        },

        new LightItem
        {
            Name = "Прихожая",
            Icon = "△",
            Enabled = true
        },

        new LightItem
        {
            Name = "Ванная",
            Icon = "○",
            Enabled = false
        }
    };


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await JS.InvokeVoidAsync(
                "myHomeLights3d.init"
            );

            await UpdateLamp();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                "MY HOME LIGHTS 3D ERROR: "
                + ex.Message
            );
        }
    }


    private async Task ToggleLight(
        LightItem light)
    {
        light.Enabled = !light.Enabled;

        await UpdateLamp();
    }


    private async Task UpdateLamp()
    {
        int enabledCount =
            lights.Count(x => x.Enabled);

        await JS.InvokeVoidAsync(
            "myHomeLights3d.setState",
            enabledCount
        );
    }


    public class LightItem
    {
        public string Name { get; set; } = "";

        public string Icon { get; set; } = "";

        public bool Enabled { get; set; }
    }
}