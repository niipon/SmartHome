@page "/lights"

@rendermode InteractiveServer

@using Microsoft.JSInterop

@inject IJSRuntime JS

<div class="page">

    <header class="page-header">

        <div>

            <p class="eyebrow">
                УПРАВЛЕНИЕ
            </p>

            <h1>
                Освещение
            </h1>

            <p class="subtitle">
                Управление светом в комнатах
            </p>

        </div>

        <div class="page-title-icon">
            ☼
        </div>

    </header>


    <!-- 3D ОСВЕЩЕНИЕ -->

    <section class="three-scene lights-three-scene">

        <div id="lights3d" class="three-canvas"></div>

        <div class="three-hint">
            ↔ Потяните для вращения&nbsp;&nbsp; • &nbsp;&nbsp;Колесо для масштаба
        </div>

        <div class="three-label">
            <span></span>
            LIGHTING SYSTEM
        </div>

    </section>


    <!-- ОБЗОР -->

    <section class="light-overview">

        <div>

            <span>
                Включено
            </span>

            <strong>
                2
            </strong>

        </div>


        <div>

            <span>
                Всего
            </span>

            <strong>
                4
            </strong>

        </div>

    </section>


    <!-- КОМНАТЫ -->

    <section class="section">

        <div class="section-header">

            <div>

                <p class="eyebrow">
                    КОМНАТЫ
                </p>

                <h2>
                    Освещение
                </h2>

            </div>

        </div>


        <div class="lights-grid">


            <!-- КОМНАТА -->

            <div class="light-card">

                <div class="light-card-top">

                    <div class="room-icon">
                        💡
                    </div>

                    <button class="switch active">
                        <span></span>
                    </button>

                </div>

                <h3>
                    Комната
                </h3>

                <p>
                    Основной свет
                </p>

                <span class="light-status on">
                    Включён
                </span>

            </div>


            <!-- КУХНЯ -->

            <div class="light-card">

                <div class="light-card-top">

                    <div class="room-icon">
                        🍳
                    </div>

                    <button class="switch">
                        <span></span>
                    </button>

                </div>

                <h3>
                    Кухня
                </h3>

                <p>
                    Основной свет
                </p>

                <span class="light-status">
                    Выключен
                </span>

            </div>


            <!-- ПРИХОЖАЯ -->

            <div class="light-card">

                <div class="light-card-top">

                    <div class="room-icon">
                        🚪
                    </div>

                    <button class="switch active">
                        <span></span>
                    </button>

                </div>

                <h3>
                    Прихожая
                </h3>

                <p>
                    Основной свет
                </p>

                <span class="light-status on">
                    Включён
                </span>

            </div>


            <!-- ВАННАЯ -->

            <div class="light-card">

                <div class="light-card-top">

                    <div class="room-icon">
                        🚿
                    </div>

                    <button class="switch">
                        <span></span>
                    </button>

                </div>

                <h3>
                    Ванная
                </h3>

                <p>
                    Основной свет
                </p>

                <span class="light-status">
                    Выключен
                </span>

            </div>


        </div>

    </section>

</div>


@code {

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;


        await JS.InvokeVoidAsync(
            "MyHome3D.create",
            "lights3d",
            new
            {
                cameraX = 0,
                cameraY = 1.5,
                cameraZ = 8,
                background = 0x08090d
            }
        );


        await JS.InvokeVoidAsync(
            "MyHome3D.addSensor",
            "lights3d",
            -2,
            1,
            0,
            0xffd36a
        );


        await JS.InvokeVoidAsync(
            "MyHome3D.addSensor",
            "lights3d",
            0,
            1,
            0,
            0xffd36a
        );


        await JS.InvokeVoidAsync(
            "MyHome3D.addSensor",
            "lights3d",
            2,
            1,
            0,
            0xffd36a
        );


        await JS.InvokeVoidAsync(
            "MyHome3D.addSensor",
            "lights3d",
            0,
            2,
            0,
            0xffd36a
        );


        await JS.InvokeVoidAsync(
            "MyHomeTheme.load"
        );
    }

}