@page "/lights"

<div class="page">

    <header class="page-header">

        <div>
            <p class="eyebrow">УПРАВЛЕНИЕ</p>
            <h1>Освещение</h1>
            <p class="subtitle">
                Управление светом в комнатах
            </p>
        </div>

        <div class="page-title-icon">
            ☼
        </div>

    </header>


    <section class="light-overview">

        <div>
            <span>Включено</span>
            <strong>2</strong>
        </div>

        <div>
            <span>Всего</span>
            <strong>4</strong>
        </div>

    </section>


    <section class="section">

        <div class="section-header">

            <div>
                <p class="eyebrow">КОМНАТЫ</p>
                <h2>Освещение</h2>
            </div>

        </div>


        <div class="lights-grid">


            <div class="light-card">

                <div class="light-card-top">

                    <div class="room-icon">
                        ???
                    </div>

                    <button class="switch active">
                        <span></span>
                    </button>

                </div>

                <h3>Комната</h3>

                <p>Основной свет</p>

                <span class="light-status on">
                    Включён
                </span>

            </div>


            <div class="light-card">

                <div class="light-card-top">

                    <div class="room-icon">
                        ??
                    </div>

                    <button class="switch">
                        <span></span>
                    </button>

                </div>

                <h3>Кухня</h3>

                <p>Основной свет</p>

                <span class="light-status">
                    Выключен
                </span>

            </div>


            <div class="light-card">

                <div class="light-card-top">

                    <div class="room-icon">
                        ??
                    </div>

                    <button class="switch active">
                        <span></span>
                    </button>

                </div>

                <h3>Прихожая</h3>

                <p>Основной свет</p>

                <span class="light-status on">
                    Включён
                </span>

            </div>


            <div class="light-card">

                <div class="light-card-top">

                    <div class="room-icon">
                        ??
                    </div>

                    <button class="switch">
                        <span></span>
                    </button>

                </div>

                <h3>Ванная</h3>

                <p>Основной свет</p>

                <span class="light-status">
                    Выключен
                </span>

            </div>


        </div>

    </section>

</div>