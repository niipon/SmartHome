<div class="launch-screen @(finished ? "launch-finished" : "")">

    <div class="launch-background">
        <div class="grid-floor"></div>
    </div>

    <div class="launch-content">

        <div class="house-scene">

            <div class="house">

                <!-- основание -->
                <div class="house-base"></div>

                <!-- стены -->
                <div class="house-front"></div>
                <div class="house-side"></div>

                <!-- крыша -->
                <div class="roof roof-left"></div>
                <div class="roof roof-right"></div>

                <!-- дверь -->
                <div class="house-door">
                    <div class="door-light"></div>
                </div>

                <!-- окна -->
                <div class="house-window window-left">
                    <span></span>
                    <span></span>
                </div>

                <div class="house-window window-right">
                    <span></span>
                    <span></span>
                </div>

                <!-- боковое окно -->
                <div class="house-window window-side">
                    <span></span>
                    <span></span>
                </div>

                <!-- свет под домом -->
                <div class="house-glow"></div>

            </div>

        </div>

        <div class="launch-title">
            <div class="launch-logo">MY HOME</div>
            <div class="launch-status">
                <span class="status-dot"></span>
                SYSTEM ONLINE
            </div>
        </div>

    </div>

</div>

@code {

    [Parameter]
    public EventCallback OnFinished { get; set; }

    private bool finished;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(5500);

        finished = true;

        await Task.Delay(700);

        await OnFinished.InvokeAsync();
    }
}