    <!-- =========================
         LAUNCH SCRIPT
         ========================= -->

    <script>
        (() => {

            const STORAGE_KEY = "myhome-launch-shown";

            let launchTimer = null;
            let currentPath = window.location.pathname;


            function getLaunch() {
                return document.getElementById("launch-screen");
            }


            function hideLaunch() {

                const launch = getLaunch();

                if (!launch)
                    return;

                launch.style.display = "none";
                launch.style.opacity = "0";
                launch.style.pointerEvents = "none";

                document.body.classList.add("launch-complete");
            }


            function showLaunch() {

                const launch = getLaunch();

                if (!launch)
                    return;

                launch.style.display = "flex";
                launch.style.opacity = "1";
                launch.style.pointerEvents = "auto";

                launch.classList.remove("launch-finished");

                void launch.offsetWidth;
            }


            function startLaunch() {

                const path = window.location.pathname.toLowerCase();

                // На Login Launch никогда не показываем
                if (path.startsWith("/login")) {
                    hideLaunch();
                    return;
                }

                // Launch запускается только на Home
                if (path !== "/") {
                    hideLaunch();
                    return;
                }

                // Уже показывали Launch в этой сессии
                if (sessionStorage.getItem(STORAGE_KEY) === "true") {
                    hideLaunch();
                    return;
                }

                // Уже запущен
                if (launchTimer)
                    return;

                const launch = getLaunch();

                if (!launch)
                    return;


                console.log("MY HOME: Launch started");

                sessionStorage.setItem(STORAGE_KEY, "true");

                showLaunch();


                launchTimer = setTimeout(() => {

                    launchTimer = null;

                    const currentLaunch = getLaunch();

                    if (!currentLaunch)
                        return;


                    console.log("MY HOME: Launch finished");


                    currentLaunch.classList.add("launch-finished");


                    setTimeout(() => {

                        hideLaunch();

                        console.log(
                            "MY HOME: opening Control Center"
                        );


                        // Переход именно на Control Center
                        window.location.href = "/control-center";


                    }, 700);


                }, 5500);
            }


            function checkRoute() {

                const path = window.location.pathname;

                if (path === currentPath)
                    return;

                currentPath = path;

                console.log(
                    "MY HOME: route changed:",
                    path
                );


                // Login
                if (
                    path
                        .toLowerCase()
                        .startsWith("/login")
                ) {

                    if (launchTimer) {
                        clearTimeout(launchTimer);
                        launchTimer = null;
                    }

                    hideLaunch();

                    return;
                }


                // Home
                if (path === "/") {

                    startLaunch();

                    return;
                }


                // Любая другая страница
                hideLaunch();
            }


            // Первоначальная проверка

            if (
                window.location.pathname
                    .toLowerCase()
                    .startsWith("/login")
            ) {

                hideLaunch();

            }
            else if (
                window.location.pathname === "/"
            ) {

                startLaunch();

            }
            else {

                hideLaunch();

            }


            // Следим за переходами Blazor

            setInterval(() => {

                checkRoute();

            }, 200);


        })();
    </script>

