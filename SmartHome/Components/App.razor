<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#111827">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <base href="/" />

    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="SmartHome.styles.css" />

    <link rel="icon" type="image/png" href="smart-house.png" />
    <link rel="apple-touch-icon" href="/smart.png" />

    <HeadOutlet />

    <style>
        /* =========================
                   STARTUP SCREEN
                   ========================= */

        #startup-screen {
            position: fixed;
            inset: 0;
            z-index: 999999;
            background: #0b0d10;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 1;
            visibility: visible;
            transition: opacity 0.7s ease, visibility 0.7s ease;
        }

            #startup-screen.hide {
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
            }

        .startup-content {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        /* =========================
                   HOUSE
                   ========================= */

        .startup-house-scene {
            position: relative;
            width: 360px;
            height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            perspective: 900px;
        }

        .startup-house {
            position: relative;
            width: 240px;
            height: 170px;
            transform: rotateX(3deg) rotateY(-12deg);
            transform-style: preserve-3d;
            animation: houseAppear 1.4s ease-out forwards;
        }

        /* основание */

        .startup-house-base {
            position: absolute;
            left: 15px;
            bottom: 0;
            width: 230px;
            height: 25px;
            background: #171b21;
            border: 1px solid #2d333d;
            box-shadow: 0 15px 35px rgba(0, 0, 0, .6);
        }

        /* передняя стена */

        .startup-house-front {
            position: absolute;
            left: 20px;
            bottom: 20px;
            width: 200px;
            height: 125px;
            background: linear-gradient( 145deg, #20252c, #111419 );
            border: 1px solid #303640;
            box-shadow: inset 0 0 25px rgba(255,255,255,.02);
        }

        /* боковая стена */

        .startup-house-side {
            position: absolute;
            right: -5px;
            bottom: 20px;
            width: 45px;
            height: 125px;
            background: linear-gradient( 90deg, #161a20, #0d0f13 );
            border-top: 1px solid #303640;
            border-right: 1px solid #303640;
            border-bottom: 1px solid #303640;
        }

        /* крыша */

        .startup-roof {
            position: absolute;
            bottom: 145px;
            width: 0;
            height: 0;
            border-left: 115px solid transparent;
            border-right: 115px solid transparent;
            border-bottom: 65px solid #171b21;
            filter: drop-shadow( 0 10px 15px rgba(0,0,0,.45) );
        }

        .startup-roof-left {
            left: 5px;
        }

        .startup-roof-right {
            left: 48px;
            transform: rotateY(180deg);
            opacity: .75;
        }

        /* дверь */

        .startup-house-door {
            position: absolute;
            left: 100px;
            bottom: 20px;
            width: 42px;
            height: 78px;
            background: #0b0e12;
            border: 1px solid #343b46;
            box-shadow: inset 0 0 20px rgba(100, 160, 255, .05);
        }

        .startup-door-light {
            position: absolute;
            left: 7px;
            top: 8px;
            width: 26px;
            height: 55px;
            background: linear-gradient( 180deg, rgba(255,255,255,.08), rgba(255,255,255,.01) );
            box-shadow: 0 0 18px rgba(255,255,255,.05);
        }

        /* окна */

        .startup-house-window {
            position: absolute;
            width: 43px;
            height: 38px;
            background: linear-gradient( 135deg, #26303a, #111820 );
            border: 1px solid #4b5664;
            box-shadow: 0 0 15px rgba(100,160,255,.08);
            overflow: hidden;
        }

            .startup-house-window span {
                position: absolute;
                background: #53606e;
            }

                .startup-house-window span:first-child {
                    width: 1px;
                    height: 100%;
                    left: 50%;
                }

                .startup-house-window span:last-child {
                    width: 100%;
                    height: 1px;
                    top: 50%;
                }

        .startup-window-left {
            left: 40px;
            top: 65px;
        }

        .startup-window-right {
            right: 25px;
            top: 65px;
        }

        /* боковое окно */

        .startup-window-side {
            right: -2px;
            top: 65px;
            width: 30px;
        }

        /* свечение под домом */

        .startup-house-glow {
            position: absolute;
            left: 35px;
            bottom: -18px;
            width: 190px;
            height: 35px;
            background: radial-gradient( ellipse, rgba(80,140,255,.22), transparent 70% );
            filter: blur(8px);
            animation: glowPulse 2s ease-in-out infinite;
        }

        /* =========================
                   TITLE
                   ========================= */

        .startup-title {
            margin-top: 5px;
            text-align: center;
            animation: titleAppear 1.2s ease-out 0.5s both;
        }

        .startup-logo {
            font-size: 38px;
            font-weight: 800;
            letter-spacing: 8px;
            color: #ffffff;
            text-shadow: 0 0 20px rgba(255,255,255,.12);
        }

        .startup-status {
            margin-top: 14px;
            font-size: 11px;
            letter-spacing: 4px;
            color: #858c97;
        }

        .startup-status-dot {
            display: inline-block;
            width: 7px;
            height: 7px;
            margin-right: 8px;
            border-radius: 50%;
            background: #4ade80;
            box-shadow: 0 0 12px #4ade80;
            animation: statusPulse 1s infinite;
        }

        /* =========================
                   ANIMATIONS
                   ========================= */

        @@keyframes houseAppear {
            0%

        {
            opacity: 0;
            transform: translateY(25px) scale(.92) rotateX(3deg) rotateY(-12deg);
        }

        100% {
            opacity: 1;
            transform: translateY(0) scale(1) rotateX(3deg) rotateY(-12deg);
        }

        }

        @@keyframes titleAppear {
            from

        {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        @@keyframes glowPulse {
            0%, 100%

        {
            opacity: .5;
            transform: scale(.95);
        }

        50% {
            opacity: 1;
            transform: scale(1.05);
        }

        }

        @@keyframes statusPulse {
            0%, 100%

        {
            opacity: .35;
        }

        50% {
            opacity: 1;
        }

        }

        /* =========================
                   MOBILE
                   ========================= */

        @@media (max-width: 600px) {
            .startup-house-scene

        {
            transform: scale(.82);
        }

        .startup-logo {
            font-size: 30px;
            letter-spacing: 6px;
        }

        .startup-status {
            font-size: 9px;
            letter-spacing: 3px;
        }

        }
    </style>
</head>

<body>

    <!-- =================================
         STARTUP
         ================================= -->

    <div id="startup-screen">

        <div class="startup-content">

            <div class="startup-house-scene">

                <div class="startup-house">

                    <div class="startup-house-base"></div>

                    <div class="startup-house-front"></div>

                    <div class="startup-house-side"></div>

                    <div class="startup-roof startup-roof-left"></div>

                    <div class="startup-roof startup-roof-right"></div>

                    <div class="startup-house-door">
                        <div class="startup-door-light"></div>
                    </div>

                    <div class="startup-house-window startup-window-left">
                        <span></span>
                        <span></span>
                    </div>

                    <div class="startup-house-window startup-window-right">
                        <span></span>
                        <span></span>
                    </div>

                    <div class="startup-house-window startup-window-side">
                        <span></span>
                        <span></span>
                    </div>

                    <div class="startup-house-glow"></div>

                </div>

            </div>

            <div class="startup-title">

                <div class="startup-logo">
                    MY HOME
                </div>

                <div class="startup-status">
                    <span class="startup-status-dot"></span>
                    SYSTEM ONLINE
                </div>

            </div>

        </div>

    </div>


    <!-- =================================
         BLAZOR APP
         ================================= -->

    <Routes />


    <script src="_framework/blazor.web.js"></script>

    <script src="push-notifications.js"></script>


    <script>

        window.addEventListener("load", () => {

            setTimeout(() => {

                const screen =
                    document.getElementById(
                        "startup-screen"
                    );

                if (!screen)
                    return;

                screen.classList.add("hide");

                setTimeout(() => {

                    screen.remove();

                }, 700);

            }, 5500);

        });


        if ("serviceWorker" in navigator) {

            window.addEventListener("load", () => {

                navigator.serviceWorker
                    .register("/service-worker.js")

                    .then(() => {

                        console.log(
                            "Service Worker зарегистрирован"
                        );

                    })

                    .catch(error => {

                        console.error(
                            "Ошибка Service Worker:",
                            error
                        );

                    });

            });

        }

    </script>

</body>

</html>