        ```razor
@page "/control-center"

@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@implements IAsyncDisposable

@inject IJSRuntime JS

<div class="control-center-page">

    <canvas id="controlCenterCanvas"></canvas>

    <div class="control-center-overlay">

        <div class="control-center-brand">

            <div class="control-center-eyebrow">
                MY HOME
            </div>

            <div class="control-center-title">
                CONTROL CENTER
            </div>

            <div class="control-center-subtitle">
                Центр управления домом
            </div>

        </div>

        <div class="control-center-status">

            <span class="status-dot"></span>

            SYSTEM ONLINE

        </div>

        <div class="control-center-help">

            <span class="desktop-help">
                Наведите курсор на систему
            </span>

            <span class="mobile-help">
                Проведите пальцем для вращения
            </span>

        </div>

    </div>

</div>

@code {

    private bool initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            // Даём странице и Three.js-модулю загрузиться
            await Task.Delay(100);

            await JS.InvokeVoidAsync(
                "myHomeControlCenter.init",
                "controlCenterCanvas"
            );

            initialized = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"CONTROL CENTER INIT ERROR: {ex.Message}"
            );
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!initialized)
            return;

        try
        {
            await JS.InvokeVoidAsync(
                "myHomeControlCenter.dispose"
            );
        }
        catch
        {
            // Страница уже могла быть уничтожена
        }
    }
}
```
