@page "/control-center"

@rendermode InteractiveServer

@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject NavigationManager Navigation


<div class="control-center-page">

    <canvas id="controlCenterCanvas"></canvas>


    <div class="control-center-overlay">


        <div class="control-center-brand">

            <div class="control-center-eyebrow">
                MY HOME
            </div>

            <div class="control-center-title">
                CONTROL CENTER
            </div>

            <div class="control-center-subtitle">
                Центр управления домом
            </div>

        </div>


        <div class="control-center-status">

            <span class="status-dot"></span>

            SYSTEM ONLINE

        </div>


        <div class="control-center-help">

            <span class="desktop-help">
                Наведите курсор на систему
            </span>

            <span class="mobile-help">
                Проведите пальцем для вращения
            </span>

        </div>


    </div>

</div>


@code {

    private IJSObjectReference? module;

    private DotNetObjectReference<ControlCenter>? dotNetReference;

    private bool initialized;


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {

        if (!firstRender)
            return;


        try
        {

            await Task.Delay(300);


            module =
                await JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    "/js/myhome3d/control-center.js?v=23"
                );


            dotNetReference =
                DotNetObjectReference.Create(this);


            await module.InvokeVoidAsync(
                "init",
                "controlCenterCanvas",
                dotNetReference
            );


            initialized = true;

        }
        catch (Exception ex)
        {

            Console.WriteLine(
                $"CONTROL CENTER ERROR: {ex}"
            );

        }

    }


    [JSInvokable]
    public void NavigateFrom3D(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return;

        Console.WriteLine(
            $"CONTROL CENTER: FULL NAVIGATION -> {url}"
        );

        Navigation.NavigateTo(
            url,
            forceLoad: true
        );
    }


    public async ValueTask DisposeAsync()
    {

        if (module != null)
        {

            try
            {

                await module.InvokeVoidAsync(
                    "dispose"
                );

            }
            catch
            {
            }


            try
            {

                await module.DisposeAsync();

            }
            catch
            {
            }

        }


        dotNetReference?.Dispose();

    }

}